---
const {title, desc, logo} = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={logo} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Karantina:wght@300;400;700&display=swap" rel="stylesheet">  
  </head>
	<body>
    <slot />
	</body>
</html>
<style lang="scss" is:global>
  * {
    margin:0;
    padding:0;
    box-sizing: border-box;
  }
  :root, html {
    background: black;
    
    --white:#e0e0e0;
    --black:#000;
    --grey:#d9d9d9;
    --darkgrey:#1E1E1E;
    
    --red:#D24343;
    --violet:#313773;
    --orange:#FF792C;
    --transparent-violet:#291e4970;
    --transparent-grey:#d9d9d980;

    --color-primary:var(--white);
    --color-secondary:var(--transparent-grey);
    
    --card-background:var(--black);
    --image-filter:var(--transparent-violent);
    
    --gd-white:linear-gradient(180deg,  #fff,#ffffff36);
    --gd-violet:linear-gradient(180deg,#313773,#31377300);
  }
  body {
    margin: 0 auto;
    max-width: 1500px;
    color: var(--color-primary);
    font-family: "Inter", sans-serif;
  }
  section {
    padding: 0 5vw 2em 5vw;
    @media (max-width: 1200px){
      padding: 0 1vw 2em 1vw;
    }
  }
  ul li {list-style: none;}
  h1 {font-size: 128px;}
  h2 {font-size: 70px;}
  h3 {font-size: 40px;}
  h4 {font-size: 22px;}
  @media (max-width:800px) {
    h1 {font-size: 25vw;}
    h2 {font-size: 15vw;}
    h3 {font-size: 10vw;}
    h4 {font-size: 5vw;}
  }
  a, span {
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
  }
  a {
    color: var(--color-primary);
    &:hover {
      cursor: pointer;
    }
  }
  button {
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    font-family: "Inter", sans-serif;

    gap: 1em;
    display: flex;
    align-items: center;

    padding: 10px 2.5em;
    
    color: var(--color-primary);
    border-radius: 2em;
    border: var(--color-secondary) 1px solid;
    background: none;
    &:hover {
      cursor: pointer;
      filter: brightness(1.1);
    }
  }
  .title {
    margin: 0;
    width: fit-content;

    font-weight: 500;
    font-style: normal;
    color: transparent;

    text-transform: uppercase;
    font-family: "Karantina", system-ui;

    background: var(--gd-white);
    background-clip: text;
  }
  @keyframes slide_in_right {
    from {
      opacity: .5;
      transform: translateX(25%);
    }
    to {
      opacity: 1;
      transform: translateX(0%);
    }
  }
  @keyframes slide_in_bottom {
    from {
      opacity: .5;
      transform: translateY(25%);
    }
    to {
      opacity: 1;
      transform: translateY(0%);
    }
  }
</style>