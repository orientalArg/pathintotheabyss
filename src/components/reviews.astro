---
const {reviews} = Astro.props;
---
<section class="reviews" id="reviews" >
  {reviews.map((a) => <div class="review" id="review"><img class="logo" src={a.logo} alt=""><q><h3 class="title">{a.p}</h3></q></div>)}
</section>

<script>
let current = 0;
  let reviews = document.getElementsByClassName("review");
  reviews[0].classList.add("active")

  function changeReview(n) {
    if (n >= reviews.length) {n = 0}
    if (n < 0) {n = reviews.length - 1}

    reviews[current].classList.toggle("active")
    reviews[n].classList.toggle("active")

    current = n;
  }
</script>

<style lang="scss">
.reviews {
  
  .review {
    gap: 4em;
    padding-top: 2vw;
    display: none;
    align-items: center;
    justify-content: center;
    img {
      height: 73px;
    }
    q {
      max-width: 330px;
      position: relative;
      &::before, &::after{display: none;}
      h3 {
        position: relative;
        font-weight: lighter;
        text-transform: capitalize;
        &::before{
          top: -5%;
          left: -5%;
          content: '"';
          font-size: 2em;
          position: absolute;
          font-family: Karantina;
          color: var(--color-primary);
        }
        &::after{
          top: -5%;
          right: -5%;
          content: '"';
          font-size: 2em;
          position: absolute;
          font-family: Karantina;
          color: var(--color-primary);
        }
      }
    }
  }
  .active {
    display: flex;
  }
}
@media (max-width:800px) {
  .reviews div {
    flex-direction: column;
  }
}
</style>