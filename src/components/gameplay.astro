---
const {gameplay, btn} = Astro.props;
const {features, intro, title} = gameplay;
---
<section class="gameplay" id="gameplay">
  <div class="content">
    <div class="_title">
      <h1 class="title">{title}</h1>
      <small>{intro}</small>
    </div>
    <ul class="list">
      {features.map((a) => <li><p>{a.p}</p></li> )}
    </ul>
  </div>
  <div class="video">
    <div class="iframe_wrapper" id="iframe_wrapper">
      <div class="play_video play_pause" id="play_video">
        <p class="play">{btn.play}</p>
        <p class="pause">{btn.pause}</p>
        <img src="/images/icons/play.svg" alt="">
      </div>
      <iframe id="iframe" width="560" height="315" src="https://www.youtube.com/embed/9s-5tR0fGfM?si=BW70FephbJCklA3d=1?vq=hd1080&autoplay=0" title={intro} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
  </div>
</section>

<script>
  let togglePlay = document.querySelectorAll("#play_video")!;
  let iframe = document.getElementById("iframe")!;
  let wrapper = document.getElementById("iframe_wrapper")!;

  if(screen.width > 900) {
    window.addEventListener('load', togglePlayer);
  }

  togglePlay.forEach((btn) => btn.addEventListener("click", togglePlayer))

  //togglePlay.addEventListener("click", togglePlayer);

  function togglePlayer() {
    wrapper.classList.toggle("float")

    togglePlay.forEach((btn) => btn.classList.toggle("pause"))

    //togglePlay.classList.toggle("pause")
    if(iframe.getAttribute("src") == "https://www.youtube.com/embed/9s-5tR0fGfM?si=BW70FephbJCklA3d=1?vq=hd1080&autoplay=0") {
      return iframe.setAttribute("src", "https://www.youtube.com/embed/9s-5tR0fGfM?si=BW70FephbJCklA3d=1?vq=hd1080&autoplay=1")
    } else {
      return iframe.setAttribute("src", "https://www.youtube.com/embed/9s-5tR0fGfM?si=BW70FephbJCklA3d=1?vq=hd1080&autoplay=0")
    }
  }
</script>

<style lang="scss">
  .float {
    right: 0;
    bottom: 2em;
    position: fixed;
    max-width: 600px;
    max-height: 350px;
    width: 100%;
    height: 100%;
    padding: 10px;
    button {
      display: block;
    }
    @media (max-width: 600px) {
      max-width: 100;
      max-height: 30vh;
    }
    @media (min-width: 900px) {
      right: 2em;
      bottom: 5vh;
      max-width: 600px;
      max-height: 350px;
    }
    @media (min-width: 1440px) {
      max-width: 700px;
      max-height: 400px;
    }
  }
  .gameplay {
    gap: 10vw;
    height: 770px;
    display: flex;
    overflow: hidden;
    padding-top: 2vw;
    justify-content: space-between;
    background-position: top center;
    background-image: url(/images/tunnel.svg);
    background-size: cover;
    .content {
      gap: 10vw;
      display: flex;
      max-width: 440px;
      flex-direction: column;
      justify-content: center;
      ._title .title {
        text-transform: uppercase;
      }
      .list {
        padding: 0px;
        li {
          list-style: disc;
          color: var(--orange);
          p {
            margin: 1em 0;
            font-weight: 300;
          }
        }
      }
    }
    .video {
      z-index:3;
      width: 100%;
      height: 450px;
      margin: auto 0;
      position: relative;
      border-radius: 15px;
      &::before {
        top: 50%;
        left: 50%;
        z-index: -1;
        content: "";
        position: absolute;
        border-radius: 15px;
        width: calc(100% + 7vw);
        height: calc(100% + 7vw);
        background: var(--black);
        transform: translate(-50%,-50%);
      }
      .iframe_wrapper {
        height: 100%;
        .play_video {
          padding: 1em;
          color: grey;
          cursor: pointer;
          font-weight: 600;
          text-transform: uppercase;
          background-color: var(--violet);
          align-items: center;
          display: flex;
          position: absolute;
          z-index: 20;
          right: 10px;
          top: 10px;
          gap: 1em;
          .play {display: block;}
          .pause {display: none;}
          &:hover {text-decoration: underline dashed var(--violet);}
        }
        .pause {
          .play {display: none;}
          .pause {display: block;}
        }
        iframe {
          width :100%;
          height:100%;
          position: relative;
          border-radius: 15px;
        }
      }
    }
  }
  @media (max-width: 1000px) {
    .gameplay {
      height: auto;
      flex-direction: column;
      .content {
        max-width: 80%;
        margin: 0 auto;
        text-align: center;
        h1 {margin: 0 auto;}
        .list li {list-style: none;}
      }
      .video {
        width: 100%;
        margin: 0 auto;
        max-width: 750px;
      }
    }
  }
</style>