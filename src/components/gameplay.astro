---
const {gameplay} = Astro.props;
const {features, intro, title} = gameplay;
---

<section class="gameplay" id="gameplay">
  <div class="content">
    <div class="_title">
      <h1 class="title">{title}</h1>
      <small>{intro}</small>
    </div>
    <ul class="_features">
      <li><p>{features.first}</p></li>
      <li><p>{features.second}</p></li>
      <li><p>{features.third}</p></li>
    </ul>
  </div>
  <div class="video">
    <iframe width="560" height="315" src="https://www.youtube-nocookie.com/embed/97fyBOn6cRg?si=79oDGvVuEuZBXClY" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  </div>
</section>

<style lang="scss">
  .gameplay {
    gap: 5em;
    height: 770px;
    display: flex;
    overflow: hidden;
    justify-content: space-between;
    background: var(--transparent-violet);
    background-image: url(/images/tunnel.svg);
    background-size: cover;
    .content {
      gap: 5em;
      display: flex;
      max-width: 440px;
      flex-direction: column;
      justify-content: center;
      ._title .title {
        text-transform: uppercase;
      }
      ._features {
        padding: 0px;
        color: var(--orange);
        li p {
          margin: 1em 0;
          font-weight: 300;
          color: var(--orange);
        }
      }
    }
    .video {
      z-index:3;
      width: 100%;
      margin: auto 0;
      position: relative;
      height: fit-content;
      border-radius: 15px;
      &::before {
        top: 50%;
        left: 50%;
        z-index: -1;
        content: "";
        position: absolute;
        border-radius: 15px;
        width: calc(100% + 5em);
        height: calc(100% + 5em);
        background: var(--black);
        transform: translate(-50%,-50%);
      }
      iframe {
        width: 100%;
        height: 450px;
        border-radius: 15px;
      }
    }
  }
  @media (max-width: 1000px) {
    .gameplay {
      height: auto;
      flex-direction: column;
      .content {
        max-width: 90%;
        margin: 0 auto;
        text-align: center;
        h1 {margin: 0 auto;}
      }
      .video {
        margin: 0 auto;
        max-width: 750px;
      }
    }
  }
</style>