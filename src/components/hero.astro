---
const {game, btn, preorder, data} = Astro.props
const {platforms, slides} = data;
---
<section class="hero">

  <p hidden>header slot</p>
  <slot />

  <div class="slider">
    {slides.map(a => <img class="bg_slide" src={a.url} alt="a"/>)}
  </div>

  <div class="middle">
    <div class="_title">
      {game.name.map(a => <h1 class="stroke">{a.p}</h1>)}
    </div>
    <div class="buttons">
      <button class="learn" >{btn.learn}</button>
      <button class="reserve" >{btn.reserve}<img src="/icons/steam.svg" alt=""></button>
    </div>
  </div>

  <div class="bottom">
      <small class="preorder">{preorder}</small>
    <div class="buttons">
      {
        platforms.map((a) =>
        <a href={a.url}>
          <img src={a.image} alt="" srcset="" title={a.name}>
        </a>)
      }
      <button class="play">
        <p>{btn.play}</p>
        <img src="/icons/play.svg" alt="">
      </button>
    </div>
  </div>

</section>

<script>
  let current = 0;
  let slides = document.getElementsByClassName("bg_slide");
  slides[6].classList.add("active")
  
  function changeSlide(n) {
    if (n >= slides.length) {n = 0}
    if (n < 0) {n = slides.length - 1}

    slides[current].classList.toggle("active")
    slides[n].classList.toggle("active")

    current = n;
    
  }
</script>

<style lang="scss">
  .hero {
    gap: 6vw;
    min-height: 90vh;
    position: relative;
    
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    .slider {
      top: 0;
      left: 0;
      z-index:-10;
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: absolute;
      .bg_slide {
        display: none;
        width: 100%;
        height: 100%;
      }
      .active {
        display:block;
      }
    }
    .middle {
      ._title { 
        padding: 5vw 0;
       max-width: 600px;
      }
      .buttons {
        gap: 1em;
        display: flex;
        .learn {
          padding: 15px 2vw;
          &:hover {background: none;}
        }
        .reserve {
          font-weight: 400;
          border-radius: 5px;
          padding: 15px 2vw;
          background: var(--violet);
        }
      }
    }
    .bottom {
      width: 100%;
      display: flex;
      justify-content: space-between;
      .preorder {max-width: 400px;}
      .buttons {
        gap: 1vw;
        display: flex;
        align-items: center;  
        .play {
          padding: 0;
          border: none;
          margin-left: 2vw;
          &:hover {background: none;}
        }
      }
    }
  }
  @media (max-width:1000px) {
    .hero {
      padding: 15px 25px;
      .middle .buttons button {
        padding: 2vw;
      }
      .bottom {
        gap: 2em;
        flex-direction: column;
        .buttons .play {margin-left: auto;}
      }
    }
  }
</style>