---
const {image, btn, preorder, data} = Astro.props
const {platforms} = data;
---
<section class="hero">
  <slot />
  <div class="middle">
    <img class="_title" src={image.name} alt="">
    <div class="cta">
      <button>{btn.learn}</button>
      <button class="reserve">
        {btn.reserve}
        <img src="/icons/steam.svg" alt="">
      </button>
    </div>
  </div>
  <div class="bottom">
    <small class="preorder">{preorder}</small>
    <div class="buttons">
      {
        platforms.map((a) => <a href={a.url}>
          <img src={a.image} alt="" srcset="" title={a.name}>
        </a>)
      }
      <button class="play">
        <p>{btn.play}</p>
        <img src="/icons/play.svg" alt="">
      </button>
    </div>
  </div>
</section>
<style lang="scss">
  .hero {
    gap: 6vw;
    min-height:100vh;
    
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    
    background: url(/images/hero.png);
    background-position:center center;
    background-size: cover;
    .middle {
      ._title { 
        max-width: 100%;
        margin-bottom: 4em;
      }
      .cta {
        gap: 1em;
        display: flex;
        button {padding: 15px 25px;}
        .reserve {
          font-weight: 400;
          border-radius: 5px;
          background: var(--violet);
        }
      }
    }
    .bottom {
      width: 100%;
      display: flex;
      justify-content: space-between;
      .preorder {max-width: 400px;}
      .buttons {
        gap: 1vw;
        display: flex;
        align-items: center;  
        .play {
          padding: 0;
          border: none;
          margin-left: 2vw;
        }
      }
    }
  }
  @media (max-width:1000px) {
    .hero .bottom {
      gap: 2em;
      flex-direction: column;
      .buttons .play{
        margin-left: auto;
      }
    }
  }
</style>