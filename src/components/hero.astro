---
const {svg, btn, preorder} = Astro.props
---
<section class="hero">
  <slot />
  <div class="middle">
    <img class="_title" src={svg.name} alt="">
    <div class="cta">
      <button>{btn.learn}</button>
      <button class="reserve">
        {btn.reserve}
        <img src="/icons/steam.svg" alt="">
      </button>
    </div>
  </div>
  <div class="bottom">
    <small>
      {preorder}
    </small>
    <div class="icons">
      <div>
        <img src="/icons/microsoft.svg" alt="">
        <img src="/icons/steam.svg" alt="">
        <img src="/icons/epic.svg" alt="">
      </div>
      <button>
        <p>{btn.play}</p>
        <img src="/icons/play.svg" alt="">
      </button>
    </div>
  </div>
</section>
<style lang="scss">
  .hero {
    gap: 7vw;
    display: flex;
    flex-direction: column;
    background: url(/images/hero.png);
    background-position:center center;
    background-size: cover;
    max-height: 850px;
    .middle {
      ._title { 
        max-width: 100%;
        margin-bottom: 4em;
      }
      .cta {
        gap: 1em;
        display: flex;
        button {padding: 15px 25px;}
        .reserve {
          font-weight: 400;
          border-radius: 5px;
          background: var(--violet);
        }
      }
    }
    .bottom {
      width: 100%;
      display: flex;
      justify-content: space-between;
      small {width: 400px;}
      .icons {
        gap: 3em;
        display: flex;
        align-items: center;
        button {border: none;}
      }
    }
  }
  @media (max-width:1000px) {
    .hero .bottom {
      gap: 2em;
      flex-direction: column;
      .icons {justify-content: space-between;}
    }
  }
</style>