---
const {nav, btn} = Astro.props;

const {art, contact, devLog} = nav;
const {menu} = btn;
---
<header>
  <div class="logo">
    <img src="/logo.svg" alt="">
    <p>brainstorming</p>
    <p>films</p>
  </div>
  <div class="content">
    <nav class="nav">
      <a href="">{devLog}</a>
      <span>/</span>
      <a href="">{art}</a>
      <span>/</span>
      <a href="">{contact}</a>
    </nav>
    <div class="buttons">
      <button class="btn_lang" >
        <p>{btn.language}</p>
        <img src="/icons/globe.svg" alt="">
        <div></div>
      </button>
      <button class="btn_menu" id="menu_open">
        <span>{menu}</span>
        <img src="/icons/burguer.svg" alt="">
      </button>
    </div>
  </div>
</header>

<style lang="scss">
  header {
    width: 100%;
    display: flex;
    .logo {
      padding: 15px;
      border-radius: 0 0 15px 15px;
      background: rgb(99, 99, 99, 25%);
      img {
        width: 100%;
        margin: 0 auto;
      }
      p {
        font-size: 17px;
        font-weight: 500;
        text-align: center;
        text-transform: capitalize;
        font-family: 'Karantina', system-ui, -apple-system, Roboto;
      }
    }
    .content {
      width: 100%;
      display: flex;
      padding-left: 4em;
      align-items: center;
      justify-content: space-between;
      .nav a { margin: 0 1em;}
      .buttons {
        gap: 1em;
        display: flex;
        align-items: center;
        button {
          gap: 1em;
          display: flex;
        }
        .btn_lang {
          padding: 0;
          border: none;
          p { 
            display: none;
            animation: slide_in_right ease-out 300ms ;
          }
          &:hover p {
            display: block;
          }
        }
      }
    }
    @media (max-width:1000px) {
      .content {
        padding-left: 0;
        nav { display: none;}
        .buttons { margin-left: auto;}
      }
    }
  }
</style>