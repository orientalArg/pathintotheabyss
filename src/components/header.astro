---
import {translation} from '../i18n/utils.ts'
const {nav, btn} = translation();

const {art, contact, devLog} = nav;
const {menu} = btn;
---
<header>
  <div class="logo">
    <img src="/logo.svg" alt="">
    <p>brainstorming</p>
    <p>films</p>
  </div>
  <div class="content">
    <nav>
      <a href="">{devLog}</a>
      <span>/</span>
      <a href="">{art}</a>
      <span>/</span>
      <a href="">{contact}</a>
    </nav>
    <div class="cta">
      <button class="lang">
        <p hidden>language</p>
        <img src="/icons/globe.svg" alt="">
      </button>
      <button class="menu" id="menu_open">
        <span>
          {menu} <img src="/icons/burguer.svg" alt="">
        </span>
      </button>
    </div>
  </div>
</header>

<style lang="scss">
  header {
    width: 100%;
    display: flex;
    .logo {
      padding: 15px;
      border-radius: 0 0 15px 15px;
      background: rgb(99, 99, 99, 25%);
      img {margin: 0 auto; width: 100%;}
      p {
        margin: 0;
        font-size: 17px;
        font-weight: 500;
        text-align: center;
        text-transform: capitalize;
        font-family: 'Karantina', system-ui, -apple-system, Roboto;
      }
    }
    .content {
      width: 100%;
      display: flex;
      padding-left:4em;
      align-items: center;
      justify-content: space-between;
      nav a {margin: 0 1em;}
      .cta {
        display: flex;
        align-items: center;
        .lang {border: none;}
      }
    }
  }
