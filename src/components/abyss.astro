---
const {svg, abyss, data} = Astro.props;
---
<section class="abyss" id="abyss">
  
  <div class="_title">
    <img src={svg.theabyss} alt="a">
  </div>
  
  <div class="content">
    <div class="story">
      {abyss.story.map((a) => <p>{a.p}</p>)}
    </div>
    <div class="collection">
      <div class="buttons">
        <button id="btn_l"><img src="/icons/play.svg" alt="" srcset=""></button>
        <button id="btn_r"><img src="/icons/play.svg" alt="" srcset=""></button>
      </div>
      <div class="grid" id="slider">
        {data.slides.map((a) => <img class="slide" src={a.url} alt="" />)}
      </div>
    </div>
  </div>

  <slot />

</section>
<script>
  const slider = document.getElementById("slider");
  const w = document.body.clientWidth;
  
  const btn_r = document.getElementById("btn_r").addEventListener('click', sr);
  const btn_l = document.getElementById("btn_l").addEventListener('click', sl);
  
  function sl() {
    if(slider.scrollLeft > w) {
      const scroll = slider.scrollLeft = -w;
      return scroll;
    }
    return
  }
  function sr() {
    const scroll = slider.scrollLeft = w;
    return scroll;
  }
</script>

<style lang="scss">
.abyss {
  height: auto;
  position: relative;
  padding-bottom: 15vw;
  background-size: cover;
  background-image: url(/images/stone_figure.png);
  ._title img {
    padding: 4vw;
    margin: 0 auto;
    display: block;
  }
  .content {
    gap: 2.5em;
    display: flex;
    justify-content: space-between;
    .story {
      width: 100%;
      max-width: 450px;
      p {
        margin: 1em 0;
      }
    }
    .grid {
      gap: 3px;
      width: fit-content;
      display: grid;
      grid-template-rows: auto, 235px;
      grid-template-columns: repeat(2, minmax(353px, 1fr));
      img {
        width: 100%;
        height: auto;
      }
    }
  }
  .links {
    width: 100%;
  }
}
@media (max-width:1200px) {
  .abyss .content .grid {
    grid-template-columns: repeat(2, 300px);
  }
}
@media (max-width:1100px) {
  .abyss .content {
    text-align: center;
    align-items: center;
    flex-direction: column;
    .story {
      max-width: 75%;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(250px, 1fr));
    }
  }
}
@media (max-width:700px) {
  .abyss .content {
    .story {
    }
    .collection {
      position: relative;
      .buttons {
        left: 0;
        top: 50%;
        width: 100%;
        display: flex;
        position: absolute;
        justify-content: space-between;
      }
      .grid {
        //grid-template-columns: repeat(1, minmax(250px, 1fr));
        gap: 1em;
        width: 95vw;
        display: flex;
        overflow-x: hidden;
        .slide {
          width: 95vw;
        }
      }
    }
  }
}
</style>