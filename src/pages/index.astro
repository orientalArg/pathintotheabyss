---
import MainLayout from '../layout/mainLayout.astro'
import Header from '../components/header.astro'
import Links from '../components/links.astro'
import Reviews from '../components/reviews.astro'
import Newsletter from '../components/newsletter.astro'
import {translation} from '../i18n/utils.ts'
import Menu from '../components/menu.astro'

const {btn, svg, preorder, gameplay, specs, abyss} = translation();

const desc = gameplay.intro;
const title = desc;
const logo = "/logo.svg";
---
<MainLayout {title} {desc} {logo} >

  <Menu/>

  <section class="hero">
    <Header/>
    <div class="middle">
      <img class="_title" src={svg.name} alt="">
      <div class="cta">
        <button>{btn.learn}</button>
        <button class="reserve">
          {btn.reserve}
          <img src="/icons/steam.svg" alt="">
        </button>
      </div>
    </div>
    <div class="bottom">
      <small>
        {preorder}
      </small>
      <div class="icons">
        <div>
          <img src="/icons/microsoft.svg" alt="">
          <img src="/icons/steam.svg" alt="">
          <img src="/icons/epic.svg" alt="">
        </div>
        <button>
          <p>{btn.play}</p>
          <img src="/icons/play.svg" alt="">
        </button>
      </div>
    </div>
  </section>

  <Links />

  <section class="gameplay" id="gameplay">
    <div class="content">
      <div class="_title">
        <h1 class="title">{gameplay.title}</h1>
        <small>{gameplay.intro}</small>
      </div>
      <ul class="list">
        <li><p>{gameplay.features.first}</p></li>
        <li><p>{gameplay.features.second}</p></li>
        <li><p>{gameplay.features.third}</p></li>
      </ul>
    </div>
    <div class="video">
      <iframe width="560" height="315" src="https://www.youtube-nocookie.com/embed/97fyBOn6cRg?si=79oDGvVuEuZBXClY" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
  </section>
  
  <div id="reviews">
    <Reviews {svg} />
  </div>

  <section class="specs" id="specs">
    <h2 class="title">{specs.title}</h2>
    <div class="grid">

      <div class="card _minimum">
        <h3 class="title">{specs.system.minimum}</h3>
        <div class="wrapper">
          <ul class="c_left">
            <li><p>{specs.system.os}</p></li>
            <li><p>{specs.system.graphics}</p></li>
            <li><p>{specs.system.processor}</p></li>
            <li><p>{specs.system.memory}</p></li>
            <li><p>{specs.system.disc}</p></li>
          </ul>
          <ul class="c_right">
            <li><h4 class="title">Windows 10/Windows 11</h4></li>
            <li><h4 class="title">AMD Radeon RX 580 8GB NVIDIA GeForce GTX 1060 6GB</h4></li>
            <li><h4 class="title">AMD Ryzen 5 1600X / Intel Core i5-7600K</h4></li>
            <li><h4 class="title">8 GB</h4></li>
            <li><h4 class="title">50 GB SSD</h4></li>
          </ul>
        </div>
      </div>
      
      <div class="card _gameplay">
        <h3 class="title">{specs.gameplay.title}</h3>
        <div class="wrapper">
          <div class="columns">
            <ul class="c_left">
              <li><img src="/icons/profile.svg" alt=""></li>
              <li><img src="/icons/controller.svg" alt=""></li>
            </ul>
            <ul class="c_right">
              <li><h4 class="title">{specs.gameplay.single}</h4></li>
              <li><h4 class="title">{specs.gameplay.controller}</h4></li>
            </ul>
          </div>
          <div class="icons">
            <img src="/icons/fear.svg" alt="">
            <img src="/icons/violence.svg" alt="">
            <img src="/icons/drugs.svg" alt="">
            <img src="/icons/language.svg" alt="">
          </div>
        </div>
      </div>

      <div class="card _recommended">
        <h3 class="title">{specs.system.recommended}</h3>
        <div class="wrapper">
          <ul class="c_left">
            <li><p>{specs.system.os}</p></li>
            <li><p>{specs.system.graphics}</p></li>
            <li><p>{specs.system.processor}</p></li>
            <li><p>{specs.system.memory}</p></li>
            <li><p>{specs.system.disc}</p></li>
          </ul>
          <ul class="c_right">
            <li><h4 class="title">Windows 10/Windows 11</h4></li>
            <li><h4 class="title">AMD Radeon RX 580 8GB NVIDIA GeForce GTX 1060 6GB</h4></li>
            <li><h4 class="title">AMD Ryzen 5 1600X / Intel Core i5-7600K</h4></li>
            <li><h4 class="title">8 GB</h4></li>
            <li><h4 class="title">50 GB SSD</h4></li>
          </ul>
        </div>
      </div>
      
      <div class="card _language">
        <h3 class="title">{specs.languages.title}</h3>
        <div class="wrapper">
          <ul>
            <li>
              <h3 class="title">{specs.languages.voices.title}</h3>
            </li>
            <div class="columns">
              <li><h4 class="title">{specs.languages.voices.first}</h4></li>
              <li><h4 class="title">{specs.languages.voices.second}</h4></li>
            </div>
            <li>
              <h3 class="title">{specs.languages.subtitles.title}</h3>
            </li>
            <div class="columns">
              <li><h4 class="title">{specs.languages.subtitles.first}</h4></li>
              <li><h4 class="title">{specs.languages.subtitles.second}</h4></li>
              <li><h4 class="title">{specs.languages.subtitles.third}</h4></li>
            </div>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <div id="newsletter">
    <Newsletter/>
  </div>

  <section class="abyss" id="abyss">
    <div class="_title">
      <img src={svg.theabyss} alt="">
    </div>
    <div class="content">
      <div class="story">
        <p>{abyss.story.first}</p>
        <p>{abyss.story.second}</p>
        <p>{abyss.story.third}</p>
        <p>{abyss.story.fourth}</p>
        <p>{abyss.story.fifth}</p>
        <p>{abyss.story.sixth}</p>
        <p>{abyss.story.seventh}</p>
      </div>
      <div class="grid">
        <img src="/images/hero.png" alt="">
        <img src="/images/hero.png" alt="">
        <img src="/images/hero.png" alt="">
        <img src="/images/hero.png" alt="">
      </div>
    </div>
  </section>

  <script>
    const wrapper = document.getElementById('menu_wrapper');
    const btn =  document.getElementById('menu_open');

    btn!.onclick = () => {return wrapper!.style.display = "block"}
  </script>

</MainLayout>

<style lang="scss">
  .hero {
    gap: 7vw;
    display: flex;
    flex-direction: column;
    background: url(/images/hero.png);
    background-position:center center;
    background-size: cover;
    max-height: 850px;
    .middle {
      ._title { margin-bottom: 4em;}
      .cta {
        gap: 1em;
        display: flex;
        button {padding: 15px 25px;}
        .reserve {
          gap: .1901em;
          display: flex;
          align-items: center;
          font-weight: 400;
          border-radius: 5px;
          background: var(--violet);
        }
      }
    }
    .bottom {
      width: 100%;
      display: flex;justify-content: space-between;
      small {max-width: 400px;}
      .icons {
        gap: 3em;
        display: flex;
        align-items: center;
        button {
          gap: .5em;
          padding: 0;
          border: none;
          display: flex;
          align-items: center;
        }
      }
    }
  }
  .gameplay {
    gap: 5em;
    height: 770px;
    display: flex;
    justify-content: space-between;
    background: var(--transparent-violet);
    background-image: url(/images/tunnel.svg);
    background-size: cover;
    .content {
      gap: 5em;
      display: flex;
      max-width: 440px;
      flex-direction: column;
      justify-content: center;
      .list {
        padding: 0px;
        color: var(--orange);
        li p {
          margin: 1em 0;
          font-weight: 300;
          color: var(--orange);
        }
      }
    }
    .video {
      z-index:3;
      width: 100%;
      margin: auto 0;
      position: relative;
      height: fit-content;
      border-radius: 15px;
      &::before {
        top: 50%;
        left: 50%;
        z-index: -1;
        content: "";
        position: absolute;
        border-radius: 15px;
        width: calc(100% + 5em);
        height: calc(100% + 5em);
        background: var(--black);
        transform: translate(-50%,-50%);
      }
      iframe {
        width: 100%;
        height: 450px;
        border-radius: 15px;
      }
    }
  }
  @media (max-width: 1000px) {
    .gameplay {
      height: auto;
      padding: 4em;
      flex-direction: column;
      .content,.video {max-width: 750px;}
      .content {
        margin: 0 auto;
        text-align: center;
        h1 {margin: 0 auto;}
      }
      .video {
        margin: 0 auto;
      }
    }
  }
  .specs {
    padding: 2vw 4vw;
    min-height: 1000px;
    background-size: cover;
    background-image: url(/images/stone_figures.png);
    h2 {margin: 1em auto;}
    .grid {
      gap: 5vw;
      display: grid;
      grid-template-rows: minmax(280px, min-content);
      grid-template-columns: repeat(auto-fill, minmax(511px, 1fr));
      .card {
        width: 100%;
        height: 280px;
        max-width: 511px;
        margin: 0 auto;
        .wrapper {
          gap: 2em;
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--transparent-grey);
          padding: 2vw 1vw;
          ul {
            li {
              margin: 1em 0;
              list-style: none;
              line-height: 22px;
              h3 {
                font-size: 24px;
              }
              h4 {
                font-size: 22px;
                text-align: left;
                color: var(--red);
                text-transform: capitalize;
              }
              p {
                text-align: right ;
                text-transform: uppercase;
              }
            }
          }
        }
      }
      ._gameplay .wrapper,
      ._language .wrapper {
          flex-direction: column;
        .columns {
          gap: 2em;
          display: flex;
        }
      }
      ._gameplay .icons {
        height: 50px;
        img { height: 100%;}
      }
      ._language .wrapper .columns li {
        list-style: disc;
        color: var(--red);
      }
      @media (max-width:1000px) {
        display: flex;
        flex-direction: column;
      }
    }
  }
  .abyss {
    min-height: 980px;
    background-size: cover;
    background-image: url(/images/stone_figure.png);
    ._title img {
      padding: 4vw;
      margin: 0 auto;
      display: block;
    }
    .content {
      display:flex;
      justify-content: space-between;
      .story {
        max-width: 450px;
        p {margin: 1em 0;}
      }
      .grid {
        gap: 3px;
        display: grid;
        grid-template-rows: minmax(235px, min-content);
        grid-template-columns: repeat(2, minmax(350px, 1fr));
        img {
          width: 100%;
          height: 100%;
          max-width: 350px;
          max-height: 235px;
        }
      }
    }
  }
</style>